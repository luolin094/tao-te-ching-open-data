{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asklaotzu.com/schemas/tao-te-ching/chapter.schema.json",
  "title": "Tao Te Ching chapter",
  "type": "object",
  "required": ["n", "leggeTitle", "chinese", "english", "pairs"],
  "properties": {
    "n": {"type": "integer", "minimum": 1, "maximum": 81},
    "leggeTitle": {"type": "string", "minLength": 1},
    "chinese": {"type": "string", "minLength": 1},
    "english": {"type": "string", "minLength": 1},
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["zh", "en"],
        "properties": {"zh": {"type": "string"}, "en": {"type": "string"}},
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
